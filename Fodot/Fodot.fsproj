<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RootNamespace>Fodot</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FSharpPlus" Version="1.9.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Godot.Bridge\Godot.Bridge.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="Common\Attribute.fs" />
        <Compile Include="Common\Logger.fs" />
        <Compile Include="Common\Singleton.fs" />
        <Compile Include="Core\Variant.fs" />
        <Compile Include="Core\Callable.fs" />
        <Compile Include="Core\GodotObject.fs" />
        <Compile Include="Core\GD.fs" />
        <Compile Include="Core\FScript.fs" />
        <Compile Include="Core\Node.fs" />
        <Compile Include="Core\PackedScene.fs" />
        <Compile Include="Core\Engine.fs" />
    </ItemGroup>

</Project>
