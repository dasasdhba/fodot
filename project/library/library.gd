@tool
extends Resource
class_name Library

@export_category("Library")
@export_tool_button("Generate") var generate = _generate
@export var lib_name : String = ""
@export var lib : Dictionary[String, Resource] = {}

const FS_PROJ : String = "res://library/Fodot.Library.fsproj"
const FS_PROJ_ITEM = "<Compile Include=\"%s\"/>"
const FS_PROJ_ENTRY = FS_PROJ_ITEM % "Library.fs"

func get_lib_name():
	if lib_name == "":
		return resource_path.get_file().get_basename().to_pascal_case()
	return lib_name

func get_fs_name():
	return get_lib_name() + ".fs"

func create_fs_file():
	var library = get_lib_name()
	var fs = get_fs_name()
	var f = FileAccess.open(FS_PROJ.get_base_dir() + "/" + fs, FileAccess.WRITE)
	f.store_line("// Auto generated by resource library. DO NOT EDIT.\n")
	f.store_line("module Fodot.Library." + library + "\n")
	f.store_line("open Godot\n")
	f.store_line("let private _back_lib = GDLib(\"%s\")\n" % resource_path)
	var all = ""
	for k in lib.keys():
		var v = lib[k]
		var type = v.get_class()
		var kname = k.to_camel_case()
		if all != "": all += "; "
		all += kname
		f.store_line("let %s = _back_lib.Get<%s>(\"%s\")\n" % [kname, type, k])
	f.store_line("let all : Resource list = [%s]" % all)
	f.close()

func add_compile_item():
	var fs = get_fs_name()
	var fs_compile = FS_PROJ_ITEM % fs
	var f = FileAccess.open(FS_PROJ, FileAccess.READ_WRITE)
	var content = f.get_as_text()
	if content.find(fs_compile) < 0:
		var entry = content.find(FS_PROJ_ENTRY)
		content = content.insert(entry + FS_PROJ_ENTRY.length(), 
			"\n\t\t" + fs_compile)
		f.store_string(content)
	f.close()

func _generate():
	create_fs_file()
	add_compile_item()