<Project>
    <PropertyGroup>
        <TargetFrameworkVersion>net10.0</TargetFrameworkVersion>
        <AndroidFrameworkVersion>net10.0</AndroidFrameworkVersion>
        <DocumentationFileFlag>false</DocumentationFileFlag>
        <DocumentationFileFlag Condition = "'$(Configuration)' == 'Debug'">true</DocumentationFileFlag>
    </PropertyGroup>
</Project>