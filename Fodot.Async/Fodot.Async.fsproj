<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RootNamespace>Fodot.Async</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="GDTask.fs" />
        <Compile Include="GodotObject.fs" />
        <Compile Include="GD.fs" />
        <Compile Include="Tween.fs" />
        <Compile Include="AsyncScene.fs" />
        <Compile Include="AsyncNode.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="GDTask" Version="3.0.0" />
    </ItemGroup>
    
    <ItemGroup>
        <ProjectReference Include="..\Fodot\Fodot.fsproj" />
    </ItemGroup>

</Project>
