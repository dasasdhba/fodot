<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RootNamespace>Fodot.Module</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Vector2.fs" />
        <Compile Include="Color.fs" />
        <Compile Include="Transform2D.fs" />
        <Compile Include="CanvasItem.fs" />
        <Compile Include="Tween.fs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Fodot\Fodot.fsproj" />
    </ItemGroup>

</Project>
